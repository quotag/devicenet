# Caddy configuration for DeviceNet Kick Proxy
# Provides secure HTTPS termination on port 443 for Cloud Run -> EMQX client kick API.
# Only the narrow DELETE /api/v5/clients/hub-hub_<ulid> path is exposed, protected by X-DN-Token.

{$MQTT_DOMAIN} {
  tls /etc/certs/fullchain.pem /etc/certs/privkey.pem
  encode gzip

  @kick {
    method DELETE
    path_regexp kick ^/api/v5/clients/hub-hub_[0-9A-Z]{26}$
    header X-DN-Token {$EMQX_SHARED_TOKEN}
  }

  handle @kick {
    reverse_proxy 127.0.0.1:18083
  }

  handle /healthz {
    respond "OK" 200
  }

  handle {
    respond 404
  }
}
