# DeviceNet EMQX 5.8 Configuration (HOCON format)
# Handled via emqx.conf for user-defined configuration-as-code.
# Replaced variables (${API_URL}, ${FIREBASE_PROJECT_ID}, ${EMQX_SHARED_TOKEN}) are substituted
# on VM startup via envsubst.

node {
  name = "emqx@127.0.0.1"
  cookie = "devicenet_secret_cookie"
  data_dir = "/opt/emqx/data"
}

cluster {
  discovery_strategy = manual
}

dashboard {
  listeners {
    http {
      # Dashboard bound to 0.0.0.0 in container so Caddy and host port-forward can reach it; host restricts to 127.0.0.1
      bind = "0.0.0.0:18083"
    }
  }
}

listeners {
  tcp {
    default {
      # Plain TCP 1883 is disabled from public access
      enable = false
      bind = "127.0.0.1:1883"
    }
  }

  ssl {
    default {
      # MQTTS for hub-agent connectivity
      enable = true
      bind = "0.0.0.0:8883"
      max_connections = 1024
      ssl_options {
        cacertfile = "/etc/certs/fullchain.pem"
        certfile = "/etc/certs/fullchain.pem"
        keyfile = "/etc/certs/privkey.pem"
        verify = "verify_none"
        fail_if_no_peer_cert = false
      }
    }
  }

  ws {
    default {
      # Plain WebSocket 8083 is disabled
      enable = false
    }
  }

  wss {
    default {
      # Secure WebSocket for browser clients (web app)
      enable = true
      bind = "0.0.0.0:8084"
      max_connections = 1024
      websocket {
        mqtt_path = "/mqtt"
      }
      ssl_options {
        cacertfile = "/etc/certs/fullchain.pem"
        certfile = "/etc/certs/fullchain.pem"
        keyfile = "/etc/certs/privkey.pem"
        verify = "verify_none"
        fail_if_no_peer_cert = false
      }
    }
  }
}

# Authentication chain:
# 1. JWT authentication for Web clients using Firebase ID Token
# 2. HTTP password-based authentication for Hub clients (username: hub:<hubId>, password: hubSecret)
authentication = [
  {
    mechanism = "jwt"
    enable = true
    from = "password"
    use_jwks = true
    endpoint = "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com"
    acl_claim_name = "acl"
    verify_claims = {
      aud = "${FIREBASE_PROJECT_ID}"
      iss = "https://securetoken.google.com/${FIREBASE_PROJECT_ID}"
    }
    disconnect_after_expire = false
  },
  {
    mechanism = "password_based"
    backend = "http"
    enable = true
    method = "post"
    url = "${API_URL}/v1/emqx/auth"
    headers {
      "X-EMQX-Token" = "${EMQX_SHARED_TOKEN}"
      "Content-Type" = "application/json"
    }
    body {
      username = "${username}"
      password = "${password}"
      clientid = "${clientid}"
    }
    pool_size = 8
    connect_timeout = "5s"
    request_timeout = "5s"
    enable_pipelining = 100
    ssl {
      enable = true
    }
  }
]

# Authorization:
# JWT authenticated web clients have ACL evaluated from their token's "acl" claim.
# Hub clients fall through to HTTP authorization endpoint.
authorization {
  no_match = "deny"
  deny_action = "disconnect"
  cache {
    enable = true
    max_size = 1024
    ttl = "1m"
  }
  sources = [
    {
      type = "http"
      enable = true
      method = "post"
      url = "${API_URL}/v1/emqx/acl"
      headers {
        "X-EMQX-Token" = "${EMQX_SHARED_TOKEN}"
        "Content-Type" = "application/json"
      }
      body {
        username = "${username}"
        clientid = "${clientid}"
        topic = "${topic}"
        action = "${action}"
      }
      pool_size = 8
      connect_timeout = "5s"
      request_timeout = "5s"
      enable_pipelining = 100
      ssl {
        enable = true
      }
    }
  ]
}

# Rule Engine & HTTP Connector for forwarding Hub Status messages to API Webhook
connectors {
  http {
    status_webhook_connector {
      url = "${API_URL}"
      headers {
        "X-EMQX-Token" = "${EMQX_SHARED_TOKEN}"
        "Content-Type" = "application/json"
      }
      pool_size = 8
      connect_timeout = "5s"
      ssl {
        enable = true
      }
    }
  }
}

actions {
  http {
    status_webhook_action {
      connector = "status_webhook_connector"
      parameters {
        method = "post"
        path = "/v1/emqx/webhook"
        body = """
        {
          "topic": "${topic}",
          "payload": ${payload},
          "publish_received_at": ${publish_received_at}
        }
        """
      }
    }
  }
}

rule_engine {
  ignore_sys_message = true
  rules {
    status_webhook_rule {
      sql = "SELECT topic, payload, publish_received_at FROM \"t/+/h/+/status\""
      actions = [
        "http:status_webhook_action"
      ]
      enable = true
      description = "Forward hub status events to DeviceNet API webhook"
    }
  }
}
