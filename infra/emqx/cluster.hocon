cluster {
  name = devicenet
}

authentication {
  user_id_type = "username"
  backend = "built_in_database"
  built_in_database {
    user_id_type = "username"
  }
}

authorization {
  deny_action = "disconnect"
}

listeners {
  tcp {
    default {
      enable = false
    }
  }

  ssl {
    default {
      enable = true
      bind = "0.0.0.0:8883"
      ssl_options {
        certfile = "/etc/certs/server.crt"
        keyfile = "/etc/certs/server.key"
      }
    }
  }

  ws {
    default {
      enable = false
    }
  }

  wss {
    default {
      enable = true
      bind = "0.0.0.0:8084"
      ssl_options {
        certfile = "/etc/certs/server.crt"
        keyfile = "/etc/certs/server.key"
      }
    }
  }
}

authn = [
  {
    enable = true
    type = jwt
    use_jwks = true
    endpoint = "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com"
    acl_claim_name = "acl"
    disconnect_after_expire = false
    verify_claims = {
      aud = "${FIREBASE_PROJECT_ID}"
      iss = "https://securetoken.google.com/${FIREBASE_PROJECT_ID}"
    }
  },
  {
    enable = true
    type = "http"
    enable_pipelining = 100
    method = "post"
    url = "http://${API_HOST}:${API_PORT}/v1/emqx/auth"
    body = "raw"
    headers {
      "X-EMQX-Token" = "${EMQX_SHARED_TOKEN}"
    }
    ssl {
      enable = false
    }
  }
]

authz = [
  {
    enable = true
    type = "jwt"
    acl_claim_name = "acl"
  },
  {
    enable = true
    type = "http"
    enable_pipelining = 100
    method = "post"
    url = "http://${API_HOST}:${API_PORT}/v1/emqx/acl"
    body = "raw"
    headers {
      "X-EMQX-Token" = "${EMQX_SHARED_TOKEN}"
    }
    ssl {
      enable = false
    }
  }
]

rule_engine {
  ignore_sys_message = true
}

rules = [
  {
    id = "status_webhook"
    sql = "SELECT topic, payload, publish_received_at FROM \"t/+/h/+/status\""
    actions = [
      {
        function = "http_server"
        args = {
          url = "http://${API_HOST}:${API_PORT}/v1/emqx/webhook"
          method = "post"
          headers {
            "X-EMQX-Token" = "${EMQX_SHARED_TOKEN}"
            "Content-Type" = "application/json"
          }
          body = "raw"
        }
      }
    ]
  }
]
