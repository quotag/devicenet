    "serialport": "^12.0.0",
    "croner": "^7.0.0",
    "suncalc": "^1.9.0",
    "ulid": "^2.3.0",
    "yaml": "^2.0.0",
    "qrcode": "^1.5.0",
    "zod": "^3.0.0"
  },
