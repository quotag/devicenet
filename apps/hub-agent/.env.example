# DeviceNet Hub Agent - Environment Variables Template
#
# Hub configuration can be supplied via environment variables, CLI flags, or config.yaml.

# DeviceNet Cloud API Base URL (used for claim polling, unclaim, and token refresh)
DN_API_BASE_URL=https://devicenet-api-your-hash-as.a.run.app

# Path to the agent's persistent data directory (SQLite database, credentials)
DN_DATA_DIR=./dataDir/hub

# Development & Testing Flags
# Set DN_EMULATOR=1 to connect to local Firebase emulators and dev broker
DN_EMULATOR=0

# Set DN_MOCK_Z2M=1 to simulate Zigbee devices without real hardware dongle
DN_MOCK_Z2M=0

# Enforce TLS validation for cloud broker MQTT bridge (1 in production, 0 only in dev)
DN_CLOUD_MQTT_TLS=1

# External services configuration (1 if Mosquitto and Z2M are managed externally via Docker)
DN_EXTERNAL_SERVICES=0
DN_MQTT_HOST=127.0.0.1

# Node binary path used by supervisor when hub is packed as SEA executable
# DN_NODE_PATH=node

# Directory containing pinned helper tools (Mosquitto, Z2M)
# DN_TOOLS_DIR=./tools
