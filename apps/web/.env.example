# "cloud" (default) or "lan" (hub-served build; MQTT host = location.hostname:9001)
VITE_MODE=cloud
# 1 = connect Firebase Auth/Firestore to local emulators
VITE_USE_EMULATOR=1
VITE_FIREBASE_PROJECT_ID=demo-devicenet
VITE_FIREBASE_API_KEY=demo-key
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# host:port of Firestore emulator
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# REST api base URL (cloud only)
VITE_API_URL=http://127.0.0.1:3000
# Full MQTT-over-WebSocket URL (cloud only)
VITE_MQTT_URL=ws://localhost:8084/mqtt
# Optional base URL for downloading agent installer scripts (defaults to window.location.origin)
# VITE_AGENT_BASE_URL=https://devicenet.vn
