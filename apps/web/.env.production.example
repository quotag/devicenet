# DeviceNet Web - Production Environment Variables Template
# Copy this file to .env.production when building for Firebase Hosting / Cloud:
#   pnpm --filter web build

# Mode: cloud (connects to Cloud Run API, EMQX broker, and Firebase)
VITE_MODE=cloud

# DeviceNet Cloud Run API URL (No trailing slash)
VITE_API_URL=https://devicenet-api-<hash>-<region>.a.run.app

# Secure WebSocket MQTT URL for EMQX Broker (Path /mqtt is required)
VITE_MQTT_URL=wss://<YOUR_MQTT_DOMAIN>:8084/mqtt

# Firebase Configuration
VITE_FIREBASE_PROJECT_ID=<YOUR_GCP_FIREBASE_PROJECT_ID>
VITE_FIREBASE_API_KEY=<YOUR_FIREBASE_WEB_API_KEY>
VITE_FIREBASE_AUTH_DOMAIN=<YOUR_GCP_FIREBASE_PROJECT_ID>.firebaseapp.com

# Disable local emulators in production
# (Leave unset or "0")
# VITE_USE_EMULATOR=0
