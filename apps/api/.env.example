# DeviceNet API - Environment Variables Template
#
# In local development with Firebase emulators, standard defaults apply.
# In production (Cloud Run), these variables must be configured via environment or Secret Manager.

# Server runtime mode
NODE_ENV=production

# Server network binding (Cloud Run injects PORT=8080 automatically)
PORT=8080
HOST=0.0.0.0

# Trust Proxy headers from Cloud Run load balancer
TRUST_PROXY=true

# Google Cloud & Firebase Project Identification
GCLOUD_PROJECT=your-gcp-project-id
FIREBASE_PROJECT_ID=your-gcp-project-id

# Firebase Web API Key (public key returned in hub credentials and client configs)
FIREBASE_WEB_API_KEY=AIzaSy...

# Allowed CORS origins for web app (must be https:// URLs, comma-separated)
HOSTING_ORIGIN=https://your-gcp-project-id.web.app,https://your-gcp-project-id.firebaseapp.com

# Public base URL of this API (without trailing slash, must be https://)
DN_API_BASE_URL=https://devicenet-api-your-hash-as.a.run.app

# EMQX Broker Configuration
DN_MQTT_HOST=your-broker-domain.sslip.io
DN_MQTT_PORT=8883
DN_MQTT_WSS_PORT=8084

# Shared authentication secret between EMQX broker and API (minimum 32 characters)
EMQX_SHARED_TOKEN=replace_with_at_least_32_characters_random_token

# Optional: EMQX Admin REST API client kick configuration (via Caddy proxy)
EMQX_ADMIN_URL=https://your-broker-domain.sslip.io
EMQX_ADMIN_KEY=your_emqx_api_key
EMQX_ADMIN_SECRET=your_emqx_api_secret
